# Optional. Needed only when you explicitly request an AI overview.
# Keep the real key in your local .env file; never commit or share it.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT=5173
# Optional absolute executable paths. Leave blank for automatic local discovery.
MAILACCESS_BIN=
# Enable MailAccess account discovery by default; set false to disable.
ENABLE_ACCOUNT_DISCOVERY=true
HOLEHE_BIN=
MAIGRET_BIN=
GHUNT_BIN=
SHERLOCK_BIN=
BLACKBIRD_BIN=
PHONEINFOGA_BIN=
IGNORANT_BIN=
DETECTDEE_BIN=
DETECTDEE_DATA=
# Optional absolute path to Microsoft Edge for the HIBP browser script.
HIBP_BROWSER_BIN=
# For a source checkout, set BLACKBIRD_BIN to its venv Python and this to blackbird.py.
BLACKBIRD_SCRIPT=
# Default per-tool timeout (ms). MailAccess/Maigret get at least 300000 automatically.
SCAN_TIMEOUT_MS=240000
MAILACCESS_BUDGET_SEC=120
MAILACCESS_TIMEOUT_MS=300000
# Set to false if your MailAccess install should not run with --local-only
MAILACCESS_LOCAL_ONLY=true
MAIGRET_TOP_SITES=200
# Programmatic API (/api/v1/*). Set a long random key to require it.
CLEARTRACE_API_KEY=
MAX_CONCURRENT_SCANS=50
# Save scan history (contains emails) to disk so it survives restarts. Off by default.
PERSIST_HISTORY=false
MAX_HISTORY=200
GEMINI_MODEL=gemini-flash-latest
